{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "orderNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "currency": {
      "type": "enumeration",
      "required": true,
      "default": "PEN",
      "enum": [
        "PEN",
        "USD"
      ]
    },
    "subtotalAmount": {
      "type": "biginteger",
      "required": true
    },
    "discountAmount": {
      "type": "biginteger",
      "required": true,
      "default": "0"
    },
    "totalAmount": {
      "type": "biginteger",
      "required": true
    },
    "orderStatus": {
      "type": "enumeration",
      "required": true,
      "default": "PENDING_PAYMENT",
      "enum": [
        "PENDING_PAYMENT",
        "CONFIRMED",
        "COMPLETED",
        "CANCELLED"
      ]
    },
    "paymentStatus": {
      "type": "enumeration",
      "required": true,
      "default": "PENDING",
      "enum": [
        "PENDING",
        "IN_PROCESS",
        "APPROVED",
        "REJECTED",
        "CANCELLED",
        "REFUNDED",
        "CHARGED_BACK"
      ]
    },
    "idempotencyKey": {
      "type": "string",
      "required": true
    },
    "providerOrderId": {
      "type": "string",
      "required": false
    },
    "items": {
      "type": "component",
      "component": "shared.order-items",
      "repeatable": true,
      "required": true,
      "min": 1
    },
    "checkout_url": {
      "type": "string"
    }
  }
}
